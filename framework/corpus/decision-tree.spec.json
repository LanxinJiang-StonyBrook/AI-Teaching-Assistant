  "meta": {
    "id": "decision-tree-game",
    "title": "Decision Tree Builder Lab",
    "subtitle": "Guided walkthrough of how a decision tree is grown and applied",
    "description": "Reverse-engineered GameSpec fixture for public/decision-tree-game/index.html. This is the corpus BOUNDARY CASE: the artifact contains no accounting, auditing or AIS content whatsoever, so assurance.domain is none and notApplicable is declared rather than a citation being fabricated.",
    "course": "ACC 214 / analytics module",
    "chapter": "Decision trees (lecture slides 18-28)",
    "audience": "undergraduate students revising a lecture on decision-tree classification",
    "estimatedMinutes": 20,
    "language": "en",
    "offline": true,
    "singleFile": true,
    "sources": [
      {
        "id": "lecture-deck",
        "kind": "slide-deck",
        "citation": "Decision tree lecture slides 18-28",
        "version": "unpinned-in-original",
        "archivedAt": "NOT ARCHIVED — the original game cites \"slide 19\" with no pinned copy. Recorded here so the gap is visible rather than implied."
      }
    ]
  },
  "objectives": [
    {
      "id": "identify-parts",
      "statement": "Distinguish a decision node, a branch and a leaf in a decision tree.",
      "bloom": "understand",
      "minGradedItems": 2,
      "taughtBy": [
        "intro-teach"
      ]
    },
    {
      "id": "identify-label",
      "statement": "Distinguish the class label from the feature columns in a training set.",
      "bloom": "understand",
      "minGradedItems": 1,
      "taughtBy": [
        "data-teach",
        "training-table"
      ]
    },
    {
      "id": "choose-split",
      "statement": "Choose the split that produces the purer branches, and justify the choice by purity.",
      "bloom": "analyze",
      "minGradedItems": 2,
      "taughtBy": [
        "split-teach",
        "split-cards"
      ]
    },
    {
      "id": "grow-tree",
      "statement": "Extend a partially grown tree by adding a question only where a branch is still mixed.",
      "bloom": "analyze",
      "minGradedItems": 4,
      "maxChanceScore": 0.1,
      "taughtBy": [
        "grow-teach"
      ]
    },
    {
      "id": "apply-tree",
      "statement": "Classify an unseen record by traversing the tree from root to leaf.",
      "bloom": "apply",
      "minGradedItems": 5,
      "taughtBy": [
        "apply-teach"
      ]
    }
  ],
  "taxonomy": [
    {
      "id": "decision-node",
      "label": "Decision node",
      "shortLabel": "Node",
      "definition": "Asks a question about one feature and splits the data.",
      "objectiveIds": [
        "identify-parts"
      ]
    },
    {
      "id": "branch",
      "label": "Branch",
      "definition": "One possible answer to a decision node question.",
      "objectiveIds": [
        "identify-parts"
      ]
    },
    {
      "id": "leaf",
      "label": "Leaf",
      "definition": "The end of a path; holds the predicted class label.",
      "objectiveIds": [
        "identify-parts"
      ]
    }
  ],
