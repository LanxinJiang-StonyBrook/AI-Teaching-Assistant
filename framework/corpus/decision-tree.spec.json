  "scenario": {
    "framing": "none",
    "beats": [
      {
        "id": "intro-teach-beat",
        "kind": "scene",
        "attachTo": {
          "target": "step",
          "id": "intro-teach"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "A decision node asks a question. A branch is an answer. A leaf is a prediction."
          }
        ]
      },
      {
        "id": "data-teach-beat",
        "kind": "scene",
        "attachTo": {
          "target": "step",
          "id": "data-teach"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "One column is what you predict. The rest are what you may ask about."
          }
        ]
      },
      {
        "id": "split-teach-beat",
        "kind": "scene",
        "attachTo": {
          "target": "step",
          "id": "split-teach"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "You do not need formulas here. Compare how mixed each branch looks."
          }
        ]
      },
      {
        "id": "grow-teach-beat",
        "kind": "scene",
        "attachTo": {
          "target": "step",
          "id": "grow-teach"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "Split where the branch is still mixed. Stop where it is already pure."
          }
        ]
      },
      {
        "id": "apply-teach-beat",
        "kind": "scene",
        "attachTo": {
          "target": "step",
          "id": "apply-teach"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "Start at the root. Follow the branch that matches the client. Stop at a leaf."
          }
        ]
      },
      {
        "id": "wrap-teach-beat",
        "kind": "outcome",
        "attachTo": {
          "target": "step",
          "id": "wrap-teach"
        },
        "stamp": "RULES REVIEW",
        "blocks": [
          {
            "kind": "row",
            "label": "Rule 1",
            "value": "If marital status is Single, predict Sports Car."
          },
          {
            "kind": "row",
            "label": "Rule 2",
            "value": "If marital status is Married and gender is Female, predict Family Car."
          },
          {
            "kind": "row",
            "label": "Rule 3",
            "value": "If Married, Male, and income is 100K or below, predict Family Car."
          },
          {
            "kind": "row",
            "label": "Rule 4",
            "value": "If Married, Male, and income is above 100K, predict Sports Car."
          }
        ]
      }
    ]
