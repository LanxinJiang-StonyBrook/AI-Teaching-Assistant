    "steps": [
      {
        "id": "intro-teach",
        "segmentId": "intro",
        "order": 0,
        "graded": false,
        "objectiveIds": [
          "identify-parts"
        ],
        "prompt": "A decision tree has three parts. A **decision node** asks a question about one feature. A **branch** is one answer to that question. A **leaf** holds the predicted class label.",
        "interaction": {
          "type": "narrative",
          "beatId": "intro-teach-beat"
        }
      },
      {
        "id": "intro-node",
        "segmentId": "intro",
        "graded": true,
        "objectiveIds": [
          "identify-parts"
        ],
        "bloomDemand": "understand",
        "title": "Spot the parts",
        "prompt": "Which of these belongs in a decision node — the part of the tree that asks a question?",
        "taxonomyId": "decision-node",
        "interaction": {
          "type": "mcq",
          "shuffle": false,
          "options": [
            {
              "id": "marital",
              "label": "Marital Status",
              "detail": "A question about one feature.",
              "correct": true,
              "feedback": "Decision nodes ask questions that split the data."
            },
            {
              "id": "sports",
              "label": "Sports Car",
              "detail": "An outcome.",
              "correct": false,
              "feedback": "Sports Car is an outcome, not a question. A decision node asks something like \"What is the marital status?\""
            },
            {
              "id": "family",
              "label": "Family Car",
              "detail": "An outcome.",
              "correct": false,
              "feedback": "Family Car is an outcome, not a question. A decision node asks something like \"What is the marital status?\""
            },
            {
              "id": "leafword",
              "label": "Leaf",
              "detail": "The name of a tree part, not a feature.",
              "correct": false,
              "feedback": "A leaf is where the tree stops and states a prediction; it is not itself a question."
            }
          ]
        },
        "award": {
          "base": 1
        },
        "why": "Decision nodes ask questions that split the data.",
        "order": 1
      },
      {
        "id": "intro-leaf",
        "segmentId": "intro",
        "graded": true,
        "objectiveIds": [
          "identify-parts"
        ],
        "bloomDemand": "understand",
        "title": "Find a leaf",
        "prompt": "Now identify a leaf — the part of the tree that stores the predicted class label.",
        "taxonomyId": "leaf",
        "interaction": {
          "type": "mcq",
          "shuffle": false,
          "options": [
            {
              "id": "family",
              "label": "Family Car",
              "detail": "An end result.",
              "correct": true,
              "feedback": "A leaf is an end result like Family Car or Sports Car."
            },
            {
              "id": "income",
              "label": "Annual Income",
              "detail": "Still a question point.",
              "correct": false,
              "feedback": "Annual Income is still a question point, not an end result."
            },
            {
              "id": "gender",
              "label": "Gender",
              "detail": "Still a question point.",
              "correct": false,
              "feedback": "Gender is still a question point, not an end result."
            }
          ]
        },
        "award": {
          "base": 1
        },
        "why": "Leaves hold the predicted class label.",
        "order": 2,
        "terminal": true
      },
      {
        "id": "data-teach",
        "segmentId": "learn-from-data",
        "order": 3,
        "graded": false,
        "objectiveIds": [
          "identify-label"
        ],
        "prompt": "A supervised learner needs a **class label** — the column it is learning to predict — and **features**, the columns it is allowed to ask questions about.",
        "interaction": {
          "type": "narrative",
          "beatId": "data-teach-beat"
        }
      },
      {
        "id": "data-label",
        "segmentId": "learn-from-data",
        "graded": true,
        "objectiveIds": [
          "identify-label"
        ],
        "bloomDemand": "understand",
        "title": "Which column is the label?",
        "prompt": "In this training set, which column is the class label the tree is learning to predict?",
        "artifactIds": [
          "training-table"
        ],
        "interaction": {
          "type": "mcq",
          "shuffle": false,
          "options": [
            {
              "id": "carType",
              "label": "Car Type",
              "detail": "The prediction target.",
              "correct": true,
              "feedback": "Car type is the class label. The other columns act as features the tree uses to sort buyers."
            },
            {
              "id": "gender",
              "label": "Gender",
              "detail": "An input.",
              "correct": false,
              "feedback": "Gender is an input feature. The tree is learning to predict the final car type label."
            },
            {
              "id": "maritalStatus",
              "label": "Marital Status",
              "detail": "An input.",
              "correct": false,
              "feedback": "Marital status is an input feature. The tree is learning to predict the final car type label."
            },
            {
              "id": "annualIncome",
              "label": "Annual Income",
              "detail": "An input.",
              "correct": false,
              "feedback": "Annual income is an input feature. The tree is learning to predict the final car type label."
            }
          ]
