      {
        "id": "split-teach",
        "segmentId": "pick-the-best-split",
        "order": 5,
        "graded": false,
        "objectiveIds": [
          "choose-split"
        ],
        "prompt": "A split is better when it makes its branches **purer** — closer to holding only one class. Compare the candidates before choosing the root question.",
        "interaction": {
          "type": "narrative",
          "beatId": "split-teach-beat"
        }
      },
      {
        "id": "split-root",
        "segmentId": "pick-the-best-split",
        "graded": true,
        "objectiveIds": [
          "choose-split"
        ],
        "bloomDemand": "analyze",
        "title": "Pick the root split",
        "prompt": "Which feature makes the cleaner first split — the one whose branches are closest to pure?",
        "artifactIds": [
          "split-cards"
        ],
        "interaction": {
          "type": "mcq",
          "shuffle": false,
          "options": [
