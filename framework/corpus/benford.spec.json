        },
        "lines": [
          {
            "who": "narrator",
            "text": "Leading digits are not uniform. Find out why before you use that fact on a ledger."
          }
        ]
      },
      {
        "id": "triage-open",
        "kind": "scene",
        "attachTo": {
          "target": "segment",
          "id": "triage"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "Five populations. Some are suitable for digit analysis. Some are not. One is worth a closer look."
          }
        ]
      },
      {
        "id": "digit-chart-table",
        "kind": "scene",
        "attachTo": {
          "target": "segment",
          "id": "triage"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "Expected vs observed first-digit shares, as a table: digit 1 through digit 9, Benford expectation beside the observed share for this population."
          }
        ]
      },
      {
        "id": "pressure-meter-value",
        "kind": "scene",
        "attachTo": {
          "target": "segment",
          "id": "triage"
        },
        "lines": [
          {
            "who": "narrator",
            "text": "Digit-pattern pressure is printed as a number: the total-variation distance between the observed and expected distributions."
          }
        ]
      }
    ]
  },
