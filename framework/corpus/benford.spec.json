          "explain-mechanism"
        ],
        "title": "Generate invoices and watch the digits settle",
        "prompt": "Generate batches of 25 invoices drawn across five decades of magnitude. Watch the observed first-digit bars converge on the Benford curve.",
        "interaction": {
          "type": "sandbox",
          "generator": {
            "kind": "log-uniform",
            "params": {
              "decades": [
                1,
                6
              ]
            },
            "seed": 20260421,
            "algorithm": "lcg-park-miller"
          },
          "batchSize": 25,
          "statistic": "first-digit-histogram",
          "successCriterion": null,
          "feedbackThresholds": [
            {
              "max": 75,
              "text": "Noisy invoice sample: generate another batch."
            },
            {
              "max": 1000000000,
              "text": "The sample is settling toward the nonuniform Benford pattern."
            }
          ]
        }
      },
      {
        "id": "mech-q1",
        "segmentId": "mechanism",
        "order": 1,
        "graded": true,
        "objectiveIds": [
          "explain-mechanism"
        ],
        "bloomDemand": "understand",
        "title": "Checkpoint 1",
        "prompt": "On a multiplying scale, which first digit takes the widest stretch before it changes?",
        "artifactIds": [
          "benford-chart"
        ],
        "interaction": {
          "type": "mcq",
          "shuffle": true,
          "options": [
            {
              "id": "mech-q1-o1",
              "label": "1",
              "correct": true,
              "feedback": "Digit 1 covers the full stretch from 1.x up to 2.x. That is why about 30% of natural first digits are 1.",
              "award": 25,
              "authority": {
                "kind": "statistical",
                "ref": "Benford first-digit law",
                "sourceId": "benford-slides",
                "note": "Derivable in closed form as log10(1 + 1/d); the slide table is the pinned rendering of it."
              }
            },
            {
              "id": "mech-q1-o2",
              "label": "5",
              "correct": false,
              "feedback": "Not this one. Digit 1 covers the full stretch from 1.x up to 2.x. That is why about 30% of natural first digits are 1.",
              "misconceptionTag": "mech-q1-d2",
              "award": 0
            },
            {
              "id": "mech-q1-o3",
              "label": "9",
              "correct": false,
              "feedback": "Not this one. Digit 1 covers the full stretch from 1.x up to 2.x. That is why about 30% of natural first digits are 1.",
              "misconceptionTag": "mech-q1-d3",
              "award": 0
            }
          ]
        },
        "award": {
          "base": 25
        },
        "why": "Digit 1 covers the full stretch from 1.x up to 2.x. That is why about 30% of natural first digits are 1."
      },
      {
        "id": "mech-q2",
        "segmentId": "mechanism",
        "order": 2,
        "graded": true,
        "objectiveIds": [
          "explain-mechanism"
        ],
        "bloomDemand": "understand",
        "title": "Checkpoint 2",
        "prompt": "A diameter that starts near 9.2 only has to grow about how much before it rolls over to leading digit 1?",
        "artifactIds": [
          "benford-chart"
        ],
        "interaction": {
          "type": "mcq",
          "shuffle": true,
          "options": [
            {
              "id": "mech-q2-o1",
              "label": "About 11%",
