  "meta": {
    "id": "benford-law-game",
    "title": "Benford Audit Lab",
    "subtitle": "Mechanism lab, then audit triage",
    "description": "Reverse-engineered GameSpec fixture for public/benford-law-game/index.html. Contributes the sandbox interaction and the only assurance domain in the corpus where the taught content can be checked against a closed-form law rather than against a citation.",
    "course": "Audit analytics",
    "chapter": "Benford's Law as a screening tool",
    "audience": "undergraduate auditing students meeting digit analysis for the first time",
    "estimatedMinutes": 25,
    "language": "en",
    "offline": true,
    "singleFile": true,
    "sources": [
      {
        "id": "benford-slides",
        "kind": "slide-deck",
        "citation": "Course slides on Benford's Law",
        "version": "unpinned-in-original",
        "archivedAt": "NOT ARCHIVED — the original game says \"the slide table gives 30.10%\" with no pinned copy."
      }
    ]
  },
  "objectives": [
    {
      "id": "explain-mechanism",
      "statement": "Explain why the leading digits of naturally occurring amounts are nonuniform.",
      "bloom": "understand",
      "minGradedItems": 4,
      "taughtBy": [
        "mechanism-sandbox",
        "benford-chart"
      ]
    },
    {
      "id": "judge-suitability",
      "statement": "Judge whether a population is appropriate for digit analysis before treating a Benford deviation as a fraud lead.",
      "bloom": "evaluate",
      "minGradedItems": 5,
      "taughtBy": [
        "mechanism-sandbox"
      ]
    }
  ],
